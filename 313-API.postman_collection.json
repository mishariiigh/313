						"body": {
							"mode": "raw",
							"raw": "{\n  \"category\": \"التاريخ\",\n  \"questions\": [\n    {\n      \"question\": \"في أي عام تأسست دولة الكويت؟\",\n      \"answer\": \"1961\",\n      \"difficulty\": \"سهل\",\n      \"hint\": \"في الستينات من القرن العشرين\",\n      \"explanation\": \"حصلت الكويت على استقلالها عن بريطانيا في 19 يونيو 1961\"\n    },\n    {\n      \"question\": \"من هو أول أمير للكويت؟\",\n      \"answer\": \"الشيخ صباح الأول\",\n      \"difficulty\": \"سهل\",\n      \"hint\": \"من عائلة آل صباح\",\n      \"explanation\": \"الشيخ صباح بن جابر آل صباح (1752-1762)\"\n    },\n    {\n      \"question\": \"متى تم اكتشاف النفط في الكويت؟\",\n      \"answer\": \"1938\",\n      \"difficulty\": \"متوسط\",\n      \"hint\": \"في الثلاثينات من القرن العشرين\",\n      \"explanation\": \"تم اكتشاف النفط في بئر بحره عام 1938\"\n    },\n    {\n      \"question\": \"ما اسم أول سفينة كويتية عبرت المحيط الهندي؟\",\n      \"answer\": \"الصوري\",\n      \"difficulty\": \"متوسط\",\n      \"hint\": \"نوع من أنواع السفن التجارية\",\n      \"explanation\": \"كانت سفن الصوري تستخدم في التجارة البحرية\"\n    },\n    {\n      \"question\": \"من هو الشاعر الكويتي الملقب بشاعر الخليج؟\",\n      \"answer\": \"خالد الفرج\",\n      \"difficulty\": \"صعب\",\n      \"hint\": \"شاعر من القرن العشرين\",\n      \"explanation\": \"خالد الفرج (1898-1954) شاعر كويتي مشهور\"\n    },\n    {\n      \"question\": \"في أي عام تم افتتاح أول مدرسة نظامية في الكويت؟\",\n      \"answer\": \"1911\",\n      \"difficulty\": \"صعب\",\n      \"hint\": \"في بداية القرن العشرين\",\n      \"explanation\": \"المدرسة المباركية كانت أول مدرسة نظامية في الكويت\"\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/questions/bulk",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "questions", "bulk"]
						},
						"description": "Create 6 questions at once for a category (2 Easy, 2 Medium, 2 Hard)."
					}
